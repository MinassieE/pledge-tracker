## Database Configuration
DB_NAME=NCIC_PLEDGE
MONGO_USERNAME=your_mongodb_username
MONGO_PASSWORD=your_mongodb_password
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/NCIC_PLEDGE?retryWrites=true&w=majority

## Super Admin Configuration (First Time Setup)
AdminFirstName=Admin
AdminMiddleName=User
AdminLastName=Name
AdminEmail=admin@example.com
AdminPassword=change_this_password

## Application URLs
BASE_URL=https://your-backend-url.onrender.com
# FRONTEND_URL is used for email login links and CORS configuration
FRONTEND_URL=https://your-frontend-url.vercel.app

## Email Configuration (Gmail SMTP)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

## JWT Configuration
JWT_SECRET=your_very_secure_random_secret_key_here
JWT_EXPIRES_IN=1d

## Port (Render will set this automatically)
PORT=8001
